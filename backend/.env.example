# Cổng chạy server
PORT=5000

# Chuỗi kết nối MongoDB (local hoặc Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/aquaverse

# Khóa bí mật ký JWT (đổi sang chuỗi ngẫu nhiên dài khi deploy)
JWT_SECRET=doi_chuoi_nay_thanh_bi_mat_that_dai
JWT_EXPIRES_IN=7d

# Origin của frontend (cho CORS)
CLIENT_URL=http://localhost:5173

# Gemini API (sinh ảnh layout hồ) - lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Model sinh ảnh (mặc định dùng được nếu để trống)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image-preview
